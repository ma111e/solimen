# Runtime image for GoReleaser. The solimen binary is built by GoReleaser and
# copied in from the build context; the extension is embedded in the binary.
FROM debian:bookworm-slim

RUN adduser --disabled-password --gecos "" --shell /usr/sbin/nologin appuser

RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    # HTML-to-PDF rendering for the "pdf" output format
    wkhtmltopdf \
    # Fonts for proper rendering
    fonts-liberation \
    fonts-noto-color-emoji \
    # Additional libraries for Chromium
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    libatspi2.0-0 \
    # Additional X11 libraries
    libx11-6 \
    libxcb1 \
    libx11-xcb1 \
    xvfb \
    # Process management
    supervisor \
    # Health check
    wget \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /app

# Binary produced by GoReleaser, placed at the root of the build context.
COPY solimen /app/solimen

# Supervisor configuration (Xvfb + solimen).
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Handle directories and lock down permissions
RUN mkdir -p /var/log/supervisor \
  && chown -R appuser:appuser /app \
  && chmod 550 /app/solimen

# Expose the API port
EXPOSE 5011

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -q --spider http://localhost:${SOLIMEN_PORT:-5011}/health || exit 1

# Use supervisor to manage solimen
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
