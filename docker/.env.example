# Number of parallel Chromium instances
SOLIMEN_INSTANCES=1

# Address on the Docker host to publish the API on. The API has no
# authentication and /scrape fetches caller-supplied URLs, so do not bind it to
# a public interface.
SOLIMEN_BIND_ADDR=127.0.0.1

# Address solimen listens on inside the container. Leave as 0.0.0.0.
SOLIMEN_HOST=0.0.0.0

SOLIMEN_PORT=5011

# Enable Chromium sandbox (disabled by default; not supported in most container environments)
SOLIMEN_USE_SANDBOX=false
